# Local/dev — never commit real secrets. Production values (AWS EU / Hetzner) live in the
# deployment platform's secret manager, not in this file or in git.
DATABASE_URL="postgresql://regstack:regstack_dev@localhost:5432/regstack?schema=public"
JWT_SECRET="change-me-min-32-chars-local-dev-only"
JWT_EXPIRES_IN="8h"
PORT=4000
NODE_ENV=development

# Deadline-reminder emails (npm run reminders:send) — optional. Without RESEND_API_KEY the job
# still runs and logs what it would have sent, so local dev doesn't need an email account.
RESEND_API_KEY=""
REMINDERS_FROM_EMAIL="RegStack <reminders@regstack.de>"
REMINDERS_APP_URL="https://app.regstack.de"

# Object storage for uploaded contract documents — any S3-compatible provider works. Leave
# S3_ENDPOINT unset for AWS S3 itself; set it (and S3_FORCE_PATH_STYLE=true) for Hetzner Object
# Storage, MinIO, or similar. Without S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY, the
# upload/download-url routes return a 503 instead of the whole backend failing to boot.
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# Independent DB backup (npm run backup:run) — see docs/backup-disaster-recovery.md. Reuses the
# S3_* config above by default; set S3_BACKUP_BUCKET to keep backups in a separate bucket instead.
# Requires the `pg_dump`/`psql` client tools on PATH. DATABASE_URL for this script specifically
# should be Supabase's direct (non-pooled) connection string, not a transaction-mode pooler URL.
S3_BACKUP_BUCKET=""
# Grandfather-father-son retention: daily backups kept for N days, then one per week, then one
# per month. Defaults match the targets in docs/backup-disaster-recovery.md §2 (7/4/12).
BACKUP_RETENTION_DAILY_DAYS="7"
BACKUP_RETENTION_WEEKLY_WEEKS="4"
BACKUP_RETENTION_MONTHLY_MONTHS="12"
