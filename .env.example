# Local/dev — never commit real secrets. Production values (AWS EU / Hetzner) live in the
# deployment platform's secret manager, not in this file or in git.
DATABASE_URL="postgresql://regstack:regstack_dev@localhost:5432/regstack?schema=public"
JWT_SECRET="change-me-min-32-chars-local-dev-only"
JWT_EXPIRES_IN="8h"
PORT=4000
NODE_ENV=development

# Object storage for Contract.fileObjectKey (S3-compatible — AWS S3 EU or Hetzner Object
# Storage). Optional: the API starts and every non-upload route works without these; only
# POST/GET/DELETE on /activities/:id/contract/{upload-url,download-url,file} need them.
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
