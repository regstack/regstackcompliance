  createdAt       DateTime @default(now())

  @@index([institutionId])
  @@map("revision_sonderauftraege")
}

// Quartalsbericht/Jahresbericht (Tz. 9) — plain single-value ack (kenntnisnahmeByUserId/At,
// "first confirmer wins"), unlike Compliance's ComplianceReport: this module never outgrew that
// simple model, so it isn't given a per-user ack table it doesn't need.
model RevisionReport {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  reportType            String // "quartalsbericht" | "jahresbericht"
  periodFrom            DateTime?
  periodTo              DateTime?
  status                RevisionReportStatus @default(entwurf)
  content               Json                 @default("{}")
  finalizedAt           DateTime?
  kenntnisnahmeByUserId String?
  kenntnisnahmeAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId])
  @@map("revision_reports")
}

// ---------------------------------------------------------------------------
// Accounting / Buchhaltung — Bilanz, GuV, Anhang, Lagebericht. One row per fiscal year per
// document type; a correction supersedes the prior row via previousVersionId (same pattern as
// Nachweis) instead of overwriting it, so a finalized figure is never silently rewritten.
// Sign-off is intentionally one shared table (AccountingSignOff) across all four document types
// rather than four near-identical ack tables — mirrors ComplianceReportAcknowledgement's
// per-person model, generalized with a documentType discriminator.
// ---------------------------------------------------------------------------

enum AccountingDocStatus {
  entwurf
  final
}

enum AccountingDocumentType {
  BILANZ
  GUV
  ANHANG
  LAGEBERICHT
}

enum BilanzSeite {
  AKTIVA
  PASSIVA
}

enum BilanzSection {
  ANLAGEVERMOEGEN
  UMLAUFVERMOEGEN
  RECHNUNGSABGRENZUNG_AKTIVA
  EIGENKAPITAL
  RUECKSTELLUNGEN
  VERBINDLICHKEITEN
  RECHNUNGSABGRENZUNG_PASSIVA
}

enum GuvSection {
  ERTRAEGE
  AUFWENDUNGEN
  ERGEBNIS
}

model BalanceSheet {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  fiscalYear  Int
  periodLabel String?
  status      AccountingDocStatus @default(entwurf)
  finalizedAt DateTime?

  previousVersionId String?
  previousVersion   BalanceSheet?  @relation("BalanceSheetVersion", fields: [previousVersionId], references: [id])
  laterVersions     BalanceSheet[] @relation("BalanceSheetVersion")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems BalanceSheetLineItem[]

  @@index([institutionId, fiscalYear])
  @@map("accounting_balance_sheets")
}

model BalanceSheetLineItem {
  id             String       @id @default(uuid())
  balanceSheetId String
  balanceSheet   BalanceSheet @relation(fields: [balanceSheetId], references: [id])

  side            BilanzSeite
  section         BilanzSection
  label           String
  currentAmount   Float
  priorYearAmount Float?
  sortOrder       Int           @default(0)

  @@index([balanceSheetId])
  @@map("accounting_balance_sheet_line_items")
}

model IncomeStatement {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  fiscalYear  Int
  periodLabel String?
  status      AccountingDocStatus @default(entwurf)
  finalizedAt DateTime?

  previousVersionId String?
  previousVersion   IncomeStatement?  @relation("IncomeStatementVersion", fields: [previousVersionId], references: [id])
  laterVersions     IncomeStatement[] @relation("IncomeStatementVersion")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems IncomeStatementLineItem[]

  @@index([institutionId, fiscalYear])
  @@map("accounting_income_statements")
}

model IncomeStatementLineItem {
  id                String          @id @default(uuid())
  incomeStatementId String
  incomeStatement   IncomeStatement @relation(fields: [incomeStatementId], references: [id])

  section         GuvSection
  label           String
  currentAmount   Float
  priorYearAmount Float?
  sortOrder       Int        @default(0)

  @@index([incomeStatementId])
  @@map("accounting_income_statement_line_items")
}

// Free-text/structured notes, each section optionally tied to a line item by label (a plain
// string, not a foreign key — Bilanz and GuV line items don't share one id space, and a note may
// reference either).
model AccountingNotes {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  fiscalYear  Int
  status      AccountingDocStatus @default(entwurf)
  finalizedAt DateTime?

  previousVersionId String?
  previousVersion   AccountingNotes?  @relation("AccountingNotesVersion", fields: [previousVersionId], references: [id])
  laterVersions     AccountingNotes[] @relation("AccountingNotesVersion")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections AccountingNotesSection[]

  @@index([institutionId, fiscalYear])
  @@map("accounting_notes")
}

model AccountingNotesSection {
  id      String          @id @default(uuid())
  notesId String
  notes   AccountingNotes @relation(fields: [notesId], references: [id])

  title               String
  content             String
  linkedLineItemLabel String?
  sortOrder           Int     @default(0)

  @@index([notesId])
  @@map("accounting_notes_sections")
}

model ManagementReport {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  fiscalYear  Int
  status      AccountingDocStatus @default(entwurf)
  finalizedAt DateTime?

  previousVersionId String?
  previousVersion   ManagementReport?  @relation("ManagementReportVersion", fields: [previousVersionId], references: [id])
  laterVersions     ManagementReport[] @relation("ManagementReportVersion")

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sections ManagementReportSection[]

  @@index([institutionId, fiscalYear])
  @@map("accounting_management_reports")
}

model ManagementReportSection {
  id       String           @id @default(uuid())
  reportId String
  report   ManagementReport @relation(fields: [reportId], references: [id])

  title     String
  content   String
  sortOrder Int    @default(0)

  @@index([reportId])
  @@map("accounting_management_report_sections")
}

model AccountingSignOff {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  documentType   AccountingDocumentType
  documentId     String
  userId         String
  acknowledgedAt DateTime               @default(now())

  @@unique([documentType, documentId, userId])
  @@index([institutionId])
  @@map("accounting_sign_offs")
}

// ---------------------------------------------------------------------------
// Internal Control System (IKS) — business processes, the controls mapped to them, control
// testing with evidence, and a policy/workflow document library. "UserId" attribution fields
// follow the same plain-column convention as the rest of this schema (no FK), except
// controlOwnerUserId which mirrors Kontrolle.verantwortlichUserId.
// ---------------------------------------------------------------------------

enum IcsControlType {
  ITGC
  AUTOMATED
  MANUAL
}

enum IcsControlFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  AD_HOC
  PER_TRANSACTION
}

enum IcsControlTestStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum IcsControlTestResult {
  EFFECTIVE
  DEFICIENT
  NOT_TESTED
}

model IcsBusinessProcess {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  name        String
  owner       String?
  description String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  controls IcsControlProcess[]
  policies IcsPolicyProcess[]

  @@index([institutionId])
  @@map("ics_business_processes")
}

model IcsControl {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  code               String?
  name               String
  controlType        IcsControlType
  description        String?
  frequency          IcsControlFrequency
  controlOwnerUserId String?
  risksAddressed     String?
  active             Boolean             @default(true)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businessProcesses IcsControlProcess[]
  tests             IcsControlTest[]
  policies          IcsPolicyControl[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@map("ics_controls")
}

model IcsControlProcess {
  controlId         String
  control           IcsControl         @relation(fields: [controlId], references: [id])
  businessProcessId String
  businessProcess   IcsBusinessProcess @relation(fields: [businessProcessId], references: [id])

  @@id([controlId, businessProcessId])
  @@map("ics_control_processes")
}

model IcsControlTest {
  id        String     @id @default(uuid())
  controlId String
  control   IcsControl @relation(fields: [controlId], references: [id])

  plannedPeriod  String?
  plannedDate    DateTime?
  status         IcsControlTestStatus  @default(PLANNED)
  result         IcsControlTestResult?
  resultNotes    String?
  testedByUserId String?
  testedAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence IcsControlTestEvidence[]

  @@index([controlId])
  @@map("ics_control_tests")
}

// Objektspeicher-Referenz (Supabase Storage), NIEMALS Inline-Blob in der DB — same convention as
// Contract.fileObjectKey elsewhere in this schema.
model IcsControlTestEvidence {
  id     String         @id @default(uuid())
  testId String
  test   IcsControlTest @relation(fields: [testId], references: [id])

  fileObjectKey String
  fileName      String
  fileSize      Int?
  fileMime      String?

  uploadedByUserId String?
  uploadedAt       DateTime @default(now())

  @@index([testId])
  @@map("ics_control_test_evidence")
}

model IcsPolicyDocument {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  title        String
  description  String?
  documentType String?

  fileObjectKey String?
  fileName      String?
  fileSize      Int?
  fileMime      String?

  uploadedByUserId String?
  uploadedAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  businessProcesses IcsPolicyProcess[]
  controls          IcsPolicyControl[]

  @@index([institutionId])
  @@map("ics_policy_documents")
}

model IcsPolicyProcess {
  policyDocumentId  String
  policyDocument    IcsPolicyDocument  @relation(fields: [policyDocumentId], references: [id])
  businessProcessId String
  businessProcess   IcsBusinessProcess @relation(fields: [businessProcessId], references: [id])

  @@id([policyDocumentId, businessProcessId])
  @@map("ics_policy_processes")
}

model IcsPolicyControl {
  policyDocumentId String
  policyDocument   IcsPolicyDocument @relation(fields: [policyDocumentId], references: [id])
  controlId        String
  control          IcsControl        @relation(fields: [controlId], references: [id])

  @@id([policyDocumentId, controlId])
  @@map("ics_policy_controls")
}

// Once a year the Geschäftsleitung receives the external auditor's (Wirtschaftsprüfer/
// Bankenaufsicht) report; Interne Revision logs it here and then distributes its findings
// (below) to the responsible Fachbereiche/Module. Deliberately its own model rather than a flag
// on Feststellung/Revisionsfeststellung — a once-a-year external event with its own GL
// Kenntnisnahme, not a norm-linked compliance gap or a self-generated internal-audit finding.
model ExternePruefung {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  pruefer       String // Name der Prüfungsgesellschaft/des Wirtschaftsprüfers
  jahr          Int
  berichtsdatum DateTime?

  glKenntnisnahmeByUserId String?
  glKenntnisnahmeAt       DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  feststellungen ExternePruefungFeststellung[]

  @@map("externe_pruefungen")
  @@index([institutionId])
}

// One row per finding from an ExternePruefung, distributed to a Fachbereich/Modul for
// remediation. Status/Schweregrad reuse the exact Compliance Feststellung workflow
// (offen → fachbereich_erledigt → wirksamkeit_bestaetigt → geschlossen, or akzeptiertes_risiko)
// since that is the same "Fachbereich remediates, Revision confirms effectiveness" pattern —
// only the source (external audit vs. norm gap) differs.
model ExternePruefungFeststellung {
  id                String   @id @default(uuid())
  institutionId     String
  institution       InstitutionProfile @relation(fields: [institutionId], references: [id])
  externePruefungId String
  externePruefung   ExternePruefung @relation(fields: [externePruefungId], references: [id])

  titel        String
  beschreibung String?
  schweregrad  Schweregrad?
  frist        DateTime?
  modul        EvidenceModule?
  fachbereich  String? // Freitext, falls kein RegStack-Modul zutrifft (z.B. IT, Personal)
  verantwortlichUserId String?

  status FeststellungStatus @default(offen)

  verteiltAm DateTime? // wann Interne Revision diese Feststellung dem Fachbereich zugewiesen hat
  verteiltVon String?

  fachbereichErledigtAm           DateTime?
  fachbereichErledigtVon          String?
  wirksamkeitBestaetigtAm         DateTime?
  wirksamkeitBestaetigtVon        String?
  geschlossenAm                   DateTime?
  geschlossenVon                  String?
  akzeptiertesRisikoEntscheider   String?
  akzeptiertesRisikoUeberpruefung DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@map("externe_pruefung_feststellungen")
  @@index([institutionId])
  @@index([externePruefungId])
}

// DORA (Verordnung (EU) 2022/2554) Art. 28-30 — Register of Information über ICT-Drittanbieter.
// Bewusst ein EIGENSTÄNDIGES Register statt eine Erweiterung von OutsourcingActivity: DORA erfasst
// ALLE IKT-Dienstleistungsverträge, nicht nur die, die MaRisk AT 9 als "Auslagerung" einordnet —
// beide Register können sich auf denselben Anbieter beziehen, ohne dass eine Regelung die andere
// verzerrt. HINWEIS: Diese Feldstruktur ist eine interne Arbeitsgrundlage für die in Art. 28-30
// verlangten Kerninhalte, KEIN geprüfter 1:1-Abgleich mit den offiziellen EBA/ESA-Meldevorlagen
// (Durchführungsverordnung (EU) 2024/2956) — vor aufsichtsrechtlicher Meldung fachlich prüfen.
enum IctProviderType {
  DIREKT
  KONZERNINTERN
}

enum IctArrangementStatus {
  AKTIV
  BEENDET
}

model IctProvider {
  id                     String   @id @default(uuid())
  institutionId          String
  institution            InstitutionProfile @relation(fields: [institutionId], references: [id])

  name                   String
  legalEntityIdentifier  String?  // LEI, sofern vorhanden
  country                String?
  providerType           IctProviderType @default(DIREKT)
  parentUndertaking      String?  // Mutterunternehmen, bei Konzernbezug relevant

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  arrangements           IctArrangement[]

  @@map("ict_providers")
  @@index([institutionId])
}

model IctArrangement {
  id                       String   @id @default(uuid())
  institutionId            String
  institution              InstitutionProfile @relation(fields: [institutionId], references: [id])
  providerId               String
  provider                 IctProvider @relation(fields: [providerId], references: [id])

  functionDescription      String   // erbrachte IKT-Dienstleistung/-Funktion
  supportsCriticalFunction Boolean  @default(false) // Art. 28(3) — kritische oder wichtige Funktion
  criticalityReason        String?  // Pflicht, sobald supportsCriticalFunction = true

  contractStart            DateTime?
  contractEnd              DateTime?
  terminationNoticeMonths  Int?
  dataCategories           String?
  hasSubcontracting        Boolean  @default(false)
  subcontractingNote       String?

  status                   IctArrangementStatus @default(AKTIV)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("ict_arrangements")
  @@index([institutionId])
  @@index([providerId])
}

// ---------------------------------------------------------------------------
// Risikomanagement (MaRisk AT 4) — Risikoinventur, Strategien, Risikotragfähigkeit,
// Berichtswesen an die Geschäftsleitung. MVP-Ausschnitt gemäß
// Risikomanagement_BAIT_MVP_Spezifikation.md; Stresstests und BTR-Detailformulare
// sind bewusst Phase 2. "Rm"-Präfix auf modulweiten Enums, analog zu "Revision".
// ---------------------------------------------------------------------------

enum RisikoartKategorie {
  ADRESSENAUSFALLRISIKO
  MARKTPREISRISIKO_HANDELSBUCH
  MARKTPREISRISIKO_ANLAGEBUCH
  LIQUIDITAETSRISIKO
  OPERATIONELLES_RISIKO
  KONZENTRATIONSRISIKO
  ESG_RISIKO
  SONSTIGES_RISIKO
}

enum RmWesentlichkeit {
  wesentlich
  nicht_wesentlich
}

enum RmStrategieArt {
  geschaeftsstrategie
  risikostrategie
  teilstrategie
}

enum RmStrategieStatus {
  entwurf
  verabschiedet
}

enum RtfAnsatz {
  normativ
  oekonomisch
}

enum RmReportStatus {
  entwurf
  final
}

model Risikoinventur {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  jahr                  Int
  kategorie             RisikoartKategorie
  bezeichnung           String
  wesentlichkeit        RmWesentlichkeit
  begruendung           String?
  methodik              String?
  verantwortlichUserId  String?
  letzteUeberpruefung   DateTime?
  naechsteUeberpruefung DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rm_risikoinventur")
  @@index([institutionId])
}

model Risikostrategie {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  art                    RmStrategieArt
  jahr                   Int
  inhalt                 Json @default("{}")
  status                 RmStrategieStatus @default(entwurf)
  verabschiedetAm        DateTime?
  verabschiedetVonUserId String?
  naechsteUeberpruefung  DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rm_strategien")
  @@index([institutionId])
}

// Periodischer RTF-Snapshot statt eines einzigen laufend überschriebenen Datensatzes — jede
// Periode bleibt als eigene Zeile historisch nachvollziehbar, analog zu ComplianceRating.
model Risikotragfaehigkeit {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  periode                 String // z. B. "2026-Q1"
  ansatz                  RtfAnsatz
  risikodeckungspotenzial Float?
  limits                  Json @default("{}") // { RisikoartKategorie: { limit, auslastung } }
  auslastungGesamt        Float?
  ergebnis                String?
  methodenpruefungAm      DateTime?
  freigegebenVonUserId    String?
  freigegebenAm           DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("rm_risikotragfaehigkeit")
  @@index([institutionId])
}

model RmReport {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  reportType  String // "quartalsbericht" | "jahresbericht" | "anlassbericht"
  periodFrom  DateTime?
  periodTo    DateTime?
  status      RmReportStatus @default(entwurf)
  content     Json @default("{}")
  finalizedAt DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  acknowledgements RmReportAcknowledgement[]

  @@map("rm_reports")
  @@index([institutionId])
}

model RmReportAcknowledgement {
  id             String   @id @default(uuid())
  reportId       String
  report         RmReport @relation(fields: [reportId], references: [id])
  userId         String
  acknowledgedAt DateTime @default(now())

  @@unique([reportId, userId])
  @@map("rm_report_acknowledgements")
}

// ---------------------------------------------------------------------------
// IT-Risikomanagement / BAIT — IT-Strategie, Schutzbedarfsfeststellung,
// Informationsrisiko-Register, Sicherheitsvorfälle. MVP-Ausschnitt gemäß
// Risikomanagement_BAIT_MVP_Spezifikation.md; Benutzerberechtigungsmanagement,
// IT-Projekte und IT-Betrieb sind bewusst Phase 2. IT-Auslagerungen (BAIT Kap. 8)
// bekommen KEIN eigenes Modell — das bleibt OutsourcingActivity mit scope IKT_DORA.
// ---------------------------------------------------------------------------

enum ItStrategieStatus {
  entwurf
  verabschiedet
}

enum ItSchutzbedarf {
  normal
  hoch
  sehr_hoch
}

enum ItAssetKategorie {
  anwendung
  it_system
  netzwerk
  rechenzentrum
  sonstige
}

enum ItRisikoStatus {
  offen
  in_bearbeitung
  akzeptiert_von_gl
  geschlossen
}

enum ItVorfallSchweregrad {
  gering
  mittel
  hoch
  kritisch
}

enum ItVorfallStatus {
  offen
  in_bearbeitung
  geschlossen
}

model ItStrategie {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  jahr                                    Int
  inhalt                                  Json @default("{}")
  status                                  ItStrategieStatus @default(entwurf)
  verabschiedetAm                         DateTime?
  verabschiedetVonUserId                  String?
  konsistenzpruefungGeschaeftsstrategie   String? // Abgleichnotiz zu Geschäfts-/Risikostrategie, Kap. 1
  naechsteUeberpruefung                   DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bait_it_strategien")
  @@index([institutionId])
}

model ItAsset {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  bezeichnung       String
  kategorie         ItAssetKategorie
  eigentuemerUserId String?

  schutzbedarfVertraulichkeit ItSchutzbedarf?
  schutzbedarfIntegritaet     ItSchutzbedarf?
  schutzbedarfVerfuegbarkeit  ItSchutzbedarf?
  begruendung                 String?

  letzteUeberpruefung   DateTime?
  naechsteUeberpruefung DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  itRisiken ItRisiko[]

  @@map("bait_it_assets")
  @@index([institutionId])
}

model ItRisiko {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  assetId String?
  asset   ItAsset? @relation(fields: [assetId], references: [id])

  bedrohung                   String
  eintrittswahrscheinlichkeit String?
  auswirkung                  String?
  bruttorisiko                String?
  massnahme                   String?
  restrisiko                  String?
  status                      ItRisikoStatus @default(offen)
  verantwortlichUserId        String?
  akzeptiertVonUserId         String? // GL-Akzeptanz bei verbleibendem Restrisiko
  akzeptiertAm                DateTime?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bait_it_risiken")
  @@index([institutionId])
  @@index([assetId])
}

model ItSicherheitsvorfall {
  id            String   @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  datum             DateTime
  kategorie         String?
  schweregrad       ItVorfallSchweregrad
  beschreibung      String
  betroffeneSysteme String?
  eskalationAnUserId String?

  meldepflichtBaFin Boolean   @default(false)
  meldedatumBaFin   DateTime?

  status      ItVorfallStatus @default(offen)
  massnahme   String?
  abschlussAm DateTime?
  abschlussVonUserId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("bait_it_sicherheitsvorfaelle")
  @@index([institutionId])
}
