// ---------------------------------------------------------------------------
// DORA-Register (Art. 28-30 VO (EU) 2022/2554) — Register der Informationen über
// vertragliche Vereinbarungen mit IKT-Drittdienstleistern. Bewusst außerhalb der AT9-MVP
// gehalten (siehe README.md "Nächste Schritte") und jetzt als eigenständiges Modul nachgezogen.
//
// OutsourcingActivity.scope=IKT_DORA markiert heute schon, dass eine Auslagerung ein
// IKT-Drittdienstleister-Arrangement ist (siehe activities.routes.ts) — DoraIctArrangement
// verknüpft sich optional 1:1 auf genau diese Aktivität, ist aber ein eigenständiges Register
// mit den DORA-spezifischen Pflichtfeldern (Art. 28 Abs. 3), keine Erweiterung von
// OutsourcingActivity selbst, da das Register auch Ebenen (Konzern/Konsolidierung) und
// Governance-Felder kennt, die AT9 nicht vorsieht.
model DoraIctArrangement {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  // Optionale Verknüpfung zur zugrunde liegenden Auslagerungsaktivität (erwartet scope=IKT_DORA,
  // serverseitig geprüft in dora.routes.ts) — 1:1, ein Registereintrag pro Aktivität.
  activityId String?              @unique
  activity   OutsourcingActivity? @relation(fields: [activityId], references: [id])

  registerLevel DoraRegisterLevel @default(ENTITY)

  // Identifikation des IKT-Drittdienstleisters, Art. 28 Abs. 3 lit. a
  providerName    String
  providerLei     String? // LEI oder gleichwertige Kennung
  providerCountry String? // Sitzland des Anbieters
  providerAddress String?

  serviceType String // Art der/des erbrachten IKT-Dienstleistung(en)

  contractStart           DateTime?
  contractEnd             DateTime?
  terminationNoticeMonths Int?

  // Kritische-oder-wichtige-Funktion-Flag — unabhängig davon, ob der Anbieter selbst als
  // "kritischer IKT-Drittdienstleister" iSd DORA (Art. 31) designiert ist (zwei unabhängige
  // Felder, gleiches Prinzip wie RiskAnalysis.materiality vs. criticality bei AT9).
  criticalOrImportantFunction Boolean @default(false)
  criticalityRationale        String?
  isCriticalIctProvider       Boolean @default(false)

  dataProcessingCountries String? // Länder, in denen Daten verarbeitet/gespeichert werden

  approvedByUserId String?
  approvedAt       DateTime?
  lastReviewDate   DateTime?
  nextReviewDueAt  DateTime?

  status DoraArrangementStatus @default(ENTWURF)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subOutsourcings DoraWeiterverlagerung[]

  @@index([institutionId])
  @@map("dora_ict_arrangements")
}

// Sub-Auslagerungskette innerhalb eines DORA-Arrangements — gleiches Baumstruktur-Muster wie
// Weiterverlagerung (AT 9 Tz. 8/11): Entfernen setzt status=ENTFERNT statt zu löschen, damit die
// Kette historisch nachvollziehbar bleibt.
model DoraWeiterverlagerung {
  id            String             @id @default(uuid())
  arrangementId String
  arrangement   DoraIctArrangement @relation(fields: [arrangementId], references: [id])

  parentId String?
  parent   DoraWeiterverlagerung?  @relation("DoraWeiterverlagerungChain", fields: [parentId], references: [id])
  children DoraWeiterverlagerung[] @relation("DoraWeiterverlagerungChain")

  level       Int
  provider    String
  country     String?
  description String?
  status      DoraSubOutsourcingStatus @default(AKTIV)

  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([arrangementId])
  @@index([parentId])
  @@map("dora_weiterverlagerungen")
}

// ---------------------------------------------------------------------------
// BAIT — Bankaufsichtliche Anforderungen an die IT. Zwei Teilbereiche, bewusst als eigenständiges,
// standalone Modul aufgebaut (gleiche Philosophie wie das DORA-Register): kein Teil hier setzt
// Daten aus AT9/Compliance/Interner Revision/DORA voraus, auch wenn es inhaltlich verwandt ist.
//
// A) IT-Prüfung — ein eigenes, BAIT-skopiertes Prüfungsregister mit Feststellungen. Bewusst NICHT
//    dasselbe Modell wie Pruefung/Pruefungsobjekt/Revisionsfeststellung der Internen Revision:
//    andere Statuswerte, eigene Schweregrad-Skala, kein Vier-Augen-Arbeitspapier-Apparat.
// B) Informationsrisikomanagement (BAIT Kapitel 3) — Informationsverbund-Register mit
//    Schutzbedarfsfeststellung (Vertraulichkeit/Integrität/Verfügbarkeit/Authentizität) und eine
//    je Informationsverbund geführte Risikobewertung (Bedrohung -> Eintrittswahrscheinlichkeit ×
//    Auswirkung -> Risikoklasse -> Behandlungsentscheidung -> Restrisiko).
// ---------------------------------------------------------------------------

model BaitItPruefung {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  // Optionale Verknüpfung zum geprüften Informationsverbund (Teil B) — analog zum optionalen
  // activityId-Cross-Reference bei DoraIctArrangement: nie Pflicht, das Prüfungsregister
  // funktioniert auch, wenn das Informationsverbund-Register (noch) nicht befüllt ist.
  informationsverbundId String?
  informationsverbund   BaitInformationsverbund? @relation(fields: [informationsverbundId], references: [id])

  subject           String // Gegenstand/Umfang der Prüfung
  systemBezeichnung String? // Freitext-Bezeichnung des geprüften Systems, falls kein Informationsverbund-Eintrag existiert
  scope             String? // Prüfungsumfang / Abgrenzung

  plannedDate DateTime? // Soll-Termin
  actualDate  DateTime? // Ist-Termin der Durchführung
  pruefer     String? // Prüfer/-team, intern oder extern beauftragt

  status        BaitPruefungStatus @default(geplant)
  overallRating String? // Gesamturteil, Freitext (analog Pruefung.overallRating)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feststellungen BaitItPruefungsfeststellung[]

  @@index([institutionId])
  @@index([informationsverbundId])
  @@map("bait_it_pruefungen")
}

model BaitItPruefungsfeststellung {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  pruefungId String
  pruefung   BaitItPruefung @relation(fields: [pruefungId], references: [id])

  titel                String
  beschreibung         String?
  schweregrad          BaitFeststellungSchweregrad?
  status               BaitFeststellungStatus       @default(offen)
  frist                DateTime? // Frist zur Behebung
  verantwortlichUserId String?
  massnahme            String? // geplante/umgesetzte Abhilfemaßnahme

  geschlossenAm  DateTime?
  geschlossenVon String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId])
  @@index([pruefungId])
  @@map("bait_it_pruefungsfeststellungen")
}

model BaitInformationsverbund {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  name                 String
  beschreibung         String?
  verantwortlichUserId String?

  schutzbedarfVertraulichkeit BaitSchutzbedarf @default(normal)
  schutzbedarfIntegritaet     BaitSchutzbedarf @default(normal)
  schutzbedarfVerfuegbarkeit  BaitSchutzbedarf @default(normal)
  schutzbedarfAuthentizitaet  BaitSchutzbedarf @default(normal)
  schutzbedarfBegruendung     String? // Begründung der Einstufung — analog DoraIctArrangement.criticalityRationale

  klassifiziertAm        DateTime?
  klassifiziertVonUserId String?
  nextReviewDueAt        DateTime? // turnusmäßige Überprüfung, BAIT Kap. 3

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pruefungen        BaitItPruefung[]
  risikobewertungen BaitRisikobewertung[]

  @@index([institutionId])
  @@map("bait_informationsverbuende")
}

model BaitRisikobewertung {
  id            String             @id @default(uuid())
  institutionId String
  institution   InstitutionProfile @relation(fields: [institutionId], references: [id])

  informationsverbundId String
  informationsverbund   BaitInformationsverbund @relation(fields: [informationsverbundId], references: [id])

  bedrohung     String // Bedrohungs-/Gefährdungsbeschreibung
  schwachstelle String?

  eintrittswahrscheinlichkeit BaitRisikostufe
  auswirkung                  BaitRisikostufe
  // Serverseitig aus den beiden Werten oben abgeleitet (validation.ts::computeRisikoklasse) — nie
  // direkt vom Client gesetzt, gleiches Prinzip wie RiskAnalysis: eine Bewertung wird nicht bloß
  // behauptet, sondern nachvollziehbar aus ihren Eingaben berechnet.
  risikoklasse                BaitRisikostufe

  behandlungsoption     BaitBehandlungsoption?
  behandlungBegruendung String? // Pflicht bei Akzeptanz eines hohen/sehr hohen Risikos, siehe validation.ts::akzeptanzBegruendungMissing
  restrisiko            BaitRisikostufe?

  verantwortlichUserId String?
  bewertetAm           DateTime?
  bewertetVonUserId    String?
  nextReviewDueAt      DateTime? // turnusmäßige Überprüfung, BAIT Kap. 3

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId])
  @@index([informationsverbundId])
  @@map("bait_risikobewertungen")
}
